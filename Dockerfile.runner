FROM python:3.12-slim AS cli-build

ARG OUTCOMECI_CLI_VERSION=0.0.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION_FOR_OUTCOMECI_CLI="${OUTCOMECI_CLI_VERSION}"
ENV SETUPTOOLS_SCM_PRETEND_VERSION="${OUTCOMECI_CLI_VERSION}"
WORKDIR /source
COPY pyproject.toml README.md ./
COPY src ./src
RUN python -m pip wheel --no-cache-dir --no-deps --wheel-dir /wheels .

FROM node:22-bookworm-slim

ARG CODEX_CLI_VERSION=0.149.0
ARG CLAUDE_CODE_VERSION=2.1.238
ARG GH_CLI_VERSION=2.99.0
ARG TARGETARCH

ENV PATH="/opt/oci/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends ca-certificates curl git libexpat1 python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/oci \
    && npm install --global "@openai/codex@${CODEX_CLI_VERSION}" "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && npm cache clean --force \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx /root/.npm \
    && case "$TARGETARCH" in amd64) gh_arch=amd64 ;; arm64) gh_arch=arm64 ;; *) echo "unsupported architecture: $TARGETARCH" >&2; exit 2 ;; esac \
    && curl --fail --silent --show-error --location --output "/tmp/gh_${GH_CLI_VERSION}_linux_${gh_arch}.tar.gz" \
      "https://github.com/cli/cli/releases/download/v${GH_CLI_VERSION}/gh_${GH_CLI_VERSION}_linux_${gh_arch}.tar.gz" \
    && curl --fail --silent --show-error --location --output /tmp/checksums.txt \
      "https://github.com/cli/cli/releases/download/v${GH_CLI_VERSION}/gh_${GH_CLI_VERSION}_checksums.txt" \
    && grep " gh_${GH_CLI_VERSION}_linux_${gh_arch}.tar.gz$" /tmp/checksums.txt | sed 's#  gh_#  /tmp/gh_#' | sha256sum --check --strict \
    && tar --extract --gzip --file "/tmp/gh_${GH_CLI_VERSION}_linux_${gh_arch}.tar.gz" --strip-components=2 --directory /usr/local/bin \
      "gh_${GH_CLI_VERSION}_linux_${gh_arch}/bin/gh" \
    && rm "/tmp/gh_${GH_CLI_VERSION}_linux_${gh_arch}.tar.gz" /tmp/checksums.txt \
    && groupadd --gid 10001 runner \
    && useradd --uid 10001 --create-home --gid runner runner \
    && mkdir /work \
    && chown runner:runner /work

COPY --from=cli-build /wheels /wheels
RUN /opt/oci/bin/python -m pip install --no-cache-dir /wheels/* \
    && /opt/oci/bin/python -m pip check \
    && /opt/oci/bin/python -m pip uninstall --yes pip setuptools \
    && rm -rf /wheels

USER runner
WORKDIR /work

ENTRYPOINT ["/opt/oci/bin/python", "-m", "outcomeci.cloud_runner"]
