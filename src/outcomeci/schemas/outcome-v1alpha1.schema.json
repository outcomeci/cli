{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outcomeci.com/schemas/outcome-v1alpha1.schema.json",
  "title": "OutcomeCI Outcome Workflow",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "outcomeci.workflow/v1alpha1"},
    "kind": {"const": "OutcomeWorkflow"},
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {"name": {"$ref": "#/$defs/identifier"}},
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": ["triggers", "agents"],
      "oneOf": [
        {"required": ["instructions"], "properties": {"agents": {"not": {"required": ["orchestrator"]}}}},
        {"not": {"required": ["instructions"]}, "properties": {"agents": {"required": ["orchestrator"]}}}
      ],
      "properties": {
        "triggers": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/trigger"}
        },
        "backend": {"type": "object"},
        "context": {"type": "object"},
        "instructions": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/instruction"}
        },
        "agents": {
          "type": "object",
          "required": ["phases"],
          "properties": {
            "default": {"$ref": "#/$defs/agent"},
            "orchestrator": {
              "type": "object",
              "required": ["instructions"],
              "properties": {
                "instructions": {"type": "string", "minLength": 1},
                "runner": {"enum": ["codex", "claude", "opencode"]},
                "model": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            },
            "phases": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"$ref": "#/$defs/phase"}
            }
          },
          "allOf": [{"if": {"required": ["orchestrator"]}, "then": {"properties": {"phases": {"additionalProperties": {"required": ["type"]}}}}}],
          "additionalProperties": true
        },
        "connections": {"oneOf": [{"type": "array"}, {"type": "object"}]},
        "integration_packages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {"path": {"type": "string", "minLength": 1}},
            "additionalProperties": false
          }
        },
        "integrations": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$"},
    "trigger": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["manual", "email.received", "webhook.received"]},
        "delivery": {"enum": ["queued"]},
        "filters": {
          "type": "object",
          "properties": {
            "senders": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "subject_prefix": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "runner": {"enum": ["codex", "claude", "opencode"]},
        "model": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "instruction": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "required": ["path"],
          "properties": {"path": {"type": "string", "minLength": 1}},
          "additionalProperties": true
        }
      ]
    },
    "phase": {
      "type": "object",
      "required": ["instructions"],
      "properties": {
        "type": {"const": "agent"},
        "with": {"type": "object"},
        "instructions": {"type": "string", "minLength": 1},
        "runner": {"enum": ["codex", "claude", "opencode"]},
        "model": {"type": "string", "minLength": 1},
        "needs": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "expects": {"type": "object"},
        "integrations": {
          "type": "array",
          "items": {"oneOf": [{"$ref": "#/$defs/apiIntegration"}, {"$ref": "#/$defs/humanIntegration"}]}
        },
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "humans": {"type": "object"}
      },
      "additionalProperties": true
    },
    "apiIntegration": {
      "type": "object",
      "required": ["type", "capability"],
      "properties": {
        "type": {"const": "api"},
        "capability": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}\\.[a-z][a-z0-9_-]{0,62}$"},
        "required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "humanIntegration": {
      "type": "object",
      "required": ["type", "timing", "id", "participant", "purpose", "interaction"],
      "properties": {
        "type": {"const": "human"},
        "timing": {"enum": ["before", "during", "after"]},
        "id": {"$ref": "#/$defs/identifier"},
        "participant": {"oneOf": [{"type": "string"}, {"type": "object"}]},
        "purpose": {"type": "string", "minLength": 1},
        "interaction": {"enum": ["approval", "review", "consultation", "notification"]},
        "required": {"type": "boolean"},
        "delivery": {"type": "object"},
        "wait": {"type": "object"},
        "on_timeout": {"enum": ["fail", "continue"]},
        "availability": {"enum": ["on_demand", "always"]}
      },
      "additionalProperties": false
    }
  }
}
