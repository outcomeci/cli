{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outcomeci.com/schemas/agent-phase-v1.schema.json",
  "title": "Agent phase v1 configuration",
  "description": "A typed agent step. Payload schemas are declared through expects; runner/model inherit agents.default.",
  "type": "object",
  "required": ["type", "instructions"],
  "properties": {
    "type": {"const": "agent", "description": "Registered phase execution type."},
    "instructions": {"type": "string", "minLength": 1, "description": "Repository-relative instruction Markdown file."},
    "runner": {"enum": ["codex", "claude", "opencode"], "description": "Override the default runner."},
    "model": {"type": "string", "minLength": 1, "description": "Override the default model."},
    "needs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$"}, "description": "Prerequisite phase names; multiple ready phases may form a parallel level."},
    "with": {"type": "object", "description": "Trusted literal configuration, separate from untrusted trigger inputs. Never store credential values here."},
    "expects": {"type": "object", "properties": {"inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}}, "outputs": {"type": "array", "items": {"$ref": "#/$defs/output"}}}, "additionalProperties": false, "description": "Input/output contracts. Trigger inputs inherit their registered payload schema."},
    "integrations": {"type": "array", "items": {"type": "object"}, "description": "Phase-scoped API or human integration grants, validated by the workflow compiler."},
    "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Explicit named capabilities."},
    "humans": {"type": "object", "description": "Existing human hook configuration."}
  },
  "additionalProperties": false,
  "$defs": {
    "base": {"type": "object", "required": ["name", "media_type"], "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$"}, "media_type": {"type": "string", "pattern": "^[^/ ]+/[^/ ]+$"}, "required": {"type": "boolean"}, "schema": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object"}, {"type": "boolean"}]}, "description": {"type": "string"}}},
    "input": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "required": ["from"], "properties": {"from": {"type": "string", "minLength": 1}}}]},
    "output": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "required": ["path"], "properties": {"path": {"type": "string", "minLength": 1}}}]}
  }
}
