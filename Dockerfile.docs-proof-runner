# Thin, deliberately static image for the docs-fidelity proof: it does NOT bake
# outcomeci-cli in. docs-proof-entrypoint.sh installs it fresh from PyPI or
# CodeArtifact every run, so this always tests whatever a real user would get
# by installing the CLI right now — see docs-quickstart-v1.proof.yml.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get upgrade --yes \
    # git: outcomeci-connectors is a git dependency of outcomeci-cli, and
    # pip needs git installed to resolve it at install time.
    && apt-get install --yes --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir awscli \
    && groupadd --gid 10001 proof \
    && useradd --uid 10001 --create-home --gid proof proof \
    && mkdir /proof \
    && chown proof:proof /proof

COPY scripts/docs-proof-entrypoint.sh /usr/local/bin/docs-proof-entrypoint
RUN chmod +x /usr/local/bin/docs-proof-entrypoint

USER proof
WORKDIR /proof
ENV PATH="/home/proof/.local/bin:${PATH}"

ENTRYPOINT ["docs-proof-entrypoint"]
