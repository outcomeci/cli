FROM python:3.12-slim AS cli-build

ARG OUTCOMECI_CLI_VERSION=0.0.0
# Package-specific, not the generic SETUPTOOLS_SCM_PRETEND_VERSION: this repo
# now pulls in outcomeci-connectors as a git dependency, also built from
# source in this same `pip wheel` step, and the generic var would stamp it
# with outcomeci-cli's own pretend version too -- a real version mismatch
# pip's resolver then rejects.
ENV SETUPTOOLS_SCM_PRETEND_VERSION_FOR_OUTCOMECI_CLI="${OUTCOMECI_CLI_VERSION}"
# outcomeci-connectors is a git dependency (see pyproject.toml); resolving it
# during `pip wheel` needs git, unlike the pure-PyPI deps this stage used to
# have.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /source
COPY pyproject.toml README.md ./
COPY src ./src
RUN python -m pip wheel --no-cache-dir --wheel-dir /wheels .

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OUTCOMECI_CONFIG_HOME=/proof/.config/outcomeci

RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 proof \
    && useradd --uid 10001 --create-home --gid proof proof \
    && mkdir /proof \
    && chown proof:proof /proof

COPY --from=cli-build /wheels /wheels
# --no-deps: stage 1's `pip wheel .` already computed and built the full
# dependency closure into /wheels, including outcomeci-connectors (a git
# dependency). Without --no-deps, pip re-resolves that requirement here and
# refuses to accept the wheel already sitting in /wheels for it -- pip's
# resolver won't treat a prebuilt local wheel as satisfying a VCS/direct-URL
# dependency, even one with a matching name and version.
RUN python -m pip install --no-cache-dir --no-deps /wheels/* \
    && python -m pip check \
    && python -m pip uninstall --yes pip setuptools \
    && rm -rf /wheels

USER proof
WORKDIR /proof

ENTRYPOINT ["oci", "proof", "run"]
CMD ["--workspace", "/proof"]
